includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
        - database
    level: 6
    parallel:
        maximumNumberOfProcesses: 1
    ignoreErrors:
        # Test helper trait shipped for consuming applications, so nothing in src/ uses it.
        -
            identifier: trait.unused
            path: src/Testing/InteractsWithDataMigrations.php
